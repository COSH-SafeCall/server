# Local development only; application-local.yml imports this file.
# AWS deployment must explicitly set SPRING_PROFILES_ACTIVE=prod outside .env.
# Database Settings (apply db/schema-mysql.sql separately to an empty DB)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=safecall
DB_USERNAME=safecall_app
DB_PASSWORD=safecall_dbpwd
SERVER_PORT=8081
SWAGGER_ENABLED=true

# Independent random UTF-8 secret, minimum 32 bytes; no usable default
JWT_SECRET=
JWT_ISSUER=safecall
JWT_AUDIENCE=safecall-android
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=1209600000

# Independent Base64-encoded 32-byte random keys; never reuse JWT_SECRET
HMAC_SECRET=
RESPONSE_ENCRYPTION_SECRET=
# Per-user keys outside DB and source control. Restrict OS ACLs.
CRYPTO_KEY_DIRECTORY=.keys

# APP_ID is the numeric Kakao app ID, not the REST API key
KAKAO_APP_ID=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:8081/login/oauth2/code/kakao
AUTH_REQUESTS_PER_MINUTE=10
AUTH_CLEANUP_DELAY_MS=1000
