# Configuration template only. Fill values in your local .env.
# Empty values are placeholders, not active defaults. Remove optional lines to use application defaults.
# Local profile imports .env, not .env.example.
# AWS deployment must explicitly set SPRING_PROFILES_ACTIVE=prod outside .env.
# Database Settings (apply db/schema-mysql.sql separately to an empty DB)
# Default/reference: DB_HOST=127.0.0.1
DB_HOST=
# Default/reference: DB_PORT=3306
DB_PORT=
# Default/reference: DB_NAME=safecall
DB_NAME=
# Default/reference: DB_USERNAME=safecall_app
DB_USERNAME=
DB_PASSWORD=
# Default/reference: SERVER_PORT=8081
SERVER_PORT=
# Default/reference: SWAGGER_ENABLED=true
SWAGGER_ENABLED=

# Independent Base64-encoded 32-byte random keys; all three must differ
CSRF_SECRET=
HMAC_SECRET=
RESPONSE_ENCRYPTION_SECRET=
# Per-user keys outside DB and source control. Restrict OS ACLs.
# Default/reference: CRYPTO_KEY_DIRECTORY=.keys
CRYPTO_KEY_DIRECTORY=

# APP_ID is the numeric Kakao app ID, not the REST API key
KAKAO_APP_ID=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
# Default/reference: WEB_ORIGIN=http://localhost:8081
WEB_ORIGIN=
# Default/reference: KAKAO_REDIRECT_URI=http://localhost:8081/api/v1/auth/kakao/callback
KAKAO_REDIRECT_URI=
# Default/reference: KAKAO_LOGIN_SCOPES=name,gender,birthday,birthyear,phone_number
KAKAO_LOGIN_SCOPES=
# Default/reference: AUTH_REQUESTS_PER_MINUTE=10
AUTH_REQUESTS_PER_MINUTE=
# Default/reference: AUTH_CLEANUP_DELAY_MS=1000
AUTH_CLEANUP_DELAY_MS=

# Gemini REST auth_tokens; server-only secret. Blank disables new AI calls.
GEMINI_API_KEY=
# Default/reference: GEMINI_EPHEMERAL_TOKEN_URL=https://generativelanguage.googleapis.com/v1beta/auth_tokens
GEMINI_EPHEMERAL_TOKEN_URL=
# Upper bounds: connection 600 seconds, new connection 60 seconds.
# Default/reference: SAFECALL_GEMINI_CONNECTION_TTL_SECONDS=600
SAFECALL_GEMINI_CONNECTION_TTL_SECONDS=
# Default/reference: SAFECALL_GEMINI_NEW_SESSION_TTL_SECONDS=60
SAFECALL_GEMINI_NEW_SESSION_TTL_SECONDS=
# modelId/apiVersion/voiceId come from a validated DB prompt release, not env.
# Default/reference: CALL_WORKER_DELAY_MS=1000
CALL_WORKER_DELAY_MS=

# New calls stay blocked until a model-specific resumption/security review is registered.
GEMINI_VALIDATED_MODEL=
GEMINI_VALIDATION_REF=
# Default/reference: GEMINI_MODEL_MAX_SECONDS=0
GEMINI_MODEL_MAX_SECONDS=
# Default/reference: CALL_POLICY_VERSION=mvp-2026-09-11
CALL_POLICY_VERSION=
# Default/reference: CALL_MAX_RESUME_ATTEMPTS=1
CALL_MAX_RESUME_ATTEMPTS=
# Default/reference: CALL_RESUME_DELAY_MS=1000
CALL_RESUME_DELAY_MS=
# Default/reference: CALL_LEASE_SECONDS=30
CALL_LEASE_SECONDS=
# Default/reference: CALL_ISSUE_TIMEOUT_SECONDS=10
CALL_ISSUE_TIMEOUT_SECONDS=

# Optional reviewed Naver map template. Omit this block until review is complete.
# Default/reference: MESSAGE_MAP_VERSION=0 (mapTemplate=null)
MESSAGE_MAP_VERSION=
# Reviewed URL with exactly one {latitude} and one {longitude}; no real coordinates.
MESSAGE_MAP_URL_TEMPLATE=
# LAT_LON or LON_LAT, matching the placeholder order in the reviewed URL.
MESSAGE_MAP_COORDINATE_ORDER=
MESSAGE_MAP_ALLOWED_HOST=
MESSAGE_MAP_REVIEWED_BROWSERS=
MESSAGE_MAP_VALIDATION_REF=

# Server-only Service app admin key for account unlink after local deletion.
KAKAO_ADMIN_KEY=
